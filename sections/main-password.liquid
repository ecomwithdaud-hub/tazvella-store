<section class="tz-section" style="min-height:70vh; display:flex; align-items:center;">
  <div class="tz-container" style="max-width:34rem; text-align:center; background:var(--tz-cream-50); border:1px solid var(--tz-cream-200); border-radius:1.5rem; padding:2.5rem;">
    <span class="tz-badge tz-badge-rose">✦ Coming Soon</span>
    <h1 class="tz-serif" style="font-size:2.25rem; margin:0.75rem 0 0.5rem;">{{ shop.name }}</h1>
    <p style="font-size:0.85rem; color:var(--tz-espresso-600); margin-bottom:1.5rem;">Our aesthetic digital sanctuary is opening shortly.</p>

    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div style="display:flex; gap:0.5rem; justify-content:center;">
        <input type="password" name="password" placeholder="Enter store password" style="padding:0.7rem 1rem; border-radius:9999px; border:1px solid var(--tz-cream-300); background:var(--tz-cream-100); font-size:0.85rem;">
        <button type="submit" class="tz-btn tz-btn-primary">Enter</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password Page",
  "settings": []
}
{% endschema %}
