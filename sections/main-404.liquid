<section class="tz-section">
  <div class="tz-container" style="text-align:center; padding:4rem 1rem;">
    <span class="tz-badge tz-badge-rose">404</span>
    <h1 class="tz-section-title" style="margin-top:0.75rem;">{{ 'templates.404.title' | t }}</h1>
    <p style="font-size:0.95rem; color:var(--tz-espresso-600); margin:0.75rem 0 1.5rem;">{{ 'templates.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="tz-btn tz-btn-primary">{{ 'templates.404.back_home' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404 Not Found",
  "settings": []
}
{% endschema %}
