<section class="tz-container">
  <nav style="font-size:0.75rem; color:var(--tz-espresso-400); padding-top:1.25rem; display:flex; align-items:center; gap:0.4rem; flex-wrap:wrap;">
    <a href="{{ routes.root_url }}" style="color:inherit; text-decoration:none;">Home</a>
    <span>›</span>
    {%- if collection -%}
      <a href="{{ collection.url }}" style="color:inherit; text-decoration:none;">{{ collection.title }}</a>
      <span>›</span>
    {%- endif -%}
    <span style="color:var(--tz-espresso-900); font-weight:500;">{{ product.title }}</span>
  </nav>

  <div class="tz-pdp-grid">
    <div>
      <div class="tz-pdp-main-img">
        {%- if product.featured_image != blank -%}
          <img id="tz-pdp-main-img" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}">
        {%- else -%}
          <img id="tz-pdp-main-img" src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1200&q=80" alt="{{ product.title | escape }}">
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="tz-pdp-thumbs">
          {%- for image in product.images -%}
            <button
              type="button"
              class="tz-pdp-thumb {% if forloop.first %}is-active{% endif %}"
              data-pdp-thumb="{{ image | image_url: width: 1200 }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div style="display:flex; flex-direction:column; gap:1rem;">
      <div>
        <span class="tz-badge tz-badge-rose">✦ Instant Digital Download</span>
        <h1 class="tz-serif" style="font-size:2.15rem; font-weight:500; margin:0.65rem 0 0.45rem; line-height:1.15; color:var(--tz-espresso-950);">
          {{ product.title }}
        </h1>
        <div style="font-size:0.78rem; color:var(--tz-caramel-500); font-weight:600;">
          ★★★★★ 4.96 <span style="color:var(--tz-espresso-400); font-weight:400;">(Verified Customer Favorite)</span>
        </div>
      </div>

      <div style="display:flex; align-items:baseline; gap:0.75rem;">
        <span class="tz-serif" style="font-size:2.25rem; font-weight:700; color:var(--tz-espresso-950);">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span style="text-decoration:line-through; color:var(--tz-espresso-400); font-size:0.95rem;">{{ product.compare_at_price | money }}</span>
          {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          <span class="tz-badge tz-badge-sale">Save {{ savings }}%</span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div style="font-size:0.875rem; color:var(--tz-espresso-700); line-height:1.6; border-top:1px solid var(--tz-cream-200); padding-top:1rem;">
          {{ product.description }}
        </div>
      {%- endif -%}

      <div style="background:var(--tz-cream-50); border:1px solid var(--tz-cream-200); border-radius:1rem; padding:1rem;">
        <h3 class="tz-serif" style="font-size:1rem; font-weight:600; margin:0 0 0.5rem;">What&apos;s Included in Your Download:</h3>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.4rem; font-size:0.78rem; color:var(--tz-espresso-700);">
          <li>✓ Instant 1-Click Digital Access Link sent immediately via email</li>
          <li>✓ Lifetime Free Updates &amp; Future Aesthetic Enhancements</li>
          <li>✓ Step-by-Step Quickstart PDF Guide &amp; Video Walkthrough</li>
        </ul>
      </div>

      {% form 'product', product, data-ajax-form: '' %}
        {%- if product.variants.size > 1 -%}
          <div style="margin-bottom:0.85rem;">
            <label for="tz-variant-select" style="display:block; font-size:0.75rem; font-weight:600; margin-bottom:0.35rem;">Select Edition / Colorway</label>
            <select id="tz-variant-select" name="id" style="width:100%; padding:0.65rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300); background:var(--tz-cream-50);">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }} &ndash; {{ variant.price | money }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}

        <div style="display:flex; gap:0.65rem; align-items:center;">
          <input type="number" name="quantity" value="1" min="1" style="width:65px; text-align:center; padding:0.75rem 0.4rem; border-radius:9999px; border:1px solid var(--tz-cream-300); background:var(--tz-cream-50); font-family:monospace;">
          <button type="submit" class="tz-btn tz-btn-primary" style="flex:1;" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}
              + {{ 'products.product.add_to_cart' | t }} • {{ product.price | money }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>
      {% endform %}

      <div style="text-align:center; font-size:0.7rem; color:var(--tz-espresso-400); padding-top:0.25rem;">
        ✦ Instant Email Delivery • ✓ Lifetime Updates • ✦ Free Software Compatible
      </div>
    </div>
  </div>

  {%- if collections.all.products.size > 1 -%}
    <div style="margin-top:2.5rem; padding-top:2rem; border-top:1px solid var(--tz-cream-200); padding-bottom:3rem;">
      <h2 class="tz-serif" style="font-size:1.65rem; font-weight:500; margin:0 0 1.25rem;">You May Also Love</h2>
      <div class="tz-grid-3">
        {%- assign rel_count = 0 -%}
        {%- for p in collections.all.products -%}
          {%- if p.id != product.id and rel_count < 3 -%}
            {% render 'product-card', product: p, card_index: rel_count %}
            {%- assign rel_count = rel_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": []
}
{% endschema %}
