<section class="tz-section">
  <div class="tz-container">
    <div class="tz-section-header">
      <div class="tz-pill-badge"><span>✦ Collection</span></div>
      <h1 class="tz-section-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="tz-section-sub">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    {% paginate collection.products by 18 %}
      {%- if collection.products.size > 0 -%}
        <div class="tz-grid-3">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product, card_index: forloop.index0 %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div style="text-align:center; padding:3rem 1rem; background:var(--tz-cream-50); border-radius:1.5rem; border:1px solid var(--tz-cream-200);">
          <p class="tz-serif" style="font-size:1.25rem;">No products in this collection yet.</p>
          <a href="{{ routes.root_url }}" class="tz-btn tz-btn-primary">Back Home</a>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <div style="text-align:center; margin-top:2rem; font-size:0.85rem;">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
