<section class="tz-section">
  <div class="tz-container" style="max-width:52rem;">
    <div class="tz-section-header">
      <h1 class="tz-section-title">{{ page.title }}</h1>
    </div>
    <div style="background:var(--tz-cream-50); border:1px solid var(--tz-cream-200); border-radius:1.5rem; padding:2rem; font-size:0.95rem; line-height:1.7; color:var(--tz-espresso-700);">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
