<section id="pet-parent-collection" class="tz-section tz-pet-section">
  <div class="tz-container">
    <div class="tz-section-header">
      <div class="tz-pill-badge" style="background:var(--tz-caramel-100); border-color:var(--tz-caramel-200); color:var(--tz-caramel-800);">
        <span>♥ {{ section.settings.badge }}</span>
      </div>
      <h2 class="tz-section-title">{{ section.settings.heading }}</h2>
      <p class="tz-section-sub">{{ section.settings.subheading }}</p>
    </div>

    <div class="tz-pet-banner">
      <div class="tz-pet-banner-grid">
        <div>
          <div style="position:relative; border-radius:1rem; overflow:hidden; aspect-ratio:4/3; background:var(--tz-cream-200);">
            {%- if section.settings.banner_image != blank -%}
              <img src="{{ section.settings.banner_image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" style="width:100%; height:100%; object-fit:cover;">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=1000&q=80" alt="Pet health passport" style="width:100%; height:100%; object-fit:cover;">
            {%- endif -%}
            <div style="position:absolute; bottom:0.65rem; left:0.65rem; background:rgba(253,251,249,0.95); padding:0.35rem 0.65rem; border-radius:0.65rem; font-size:0.6875rem; font-weight:600; display:flex; align-items:center; gap:0.4rem; border:1px solid var(--tz-cream-300);">
              <span class="tz-pulse-dot"></span>
              <span>Vaccine Passport: Up to Date</span>
            </div>
          </div>
        </div>

        <div>
          <span style="font-size:0.6875rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--tz-caramel-800);">
            ✦ Multi-Pet Ready (Dogs &amp; Cats)
          </span>
          <h3 class="tz-serif" style="font-size:1.45rem; font-weight:500; margin:0.35rem 0 0; color:var(--tz-espresso-950);">
            {{ section.settings.banner_title }}
          </h3>

          <div class="tz-pet-pillars">
            <div class="tz-pillar-box">
              <strong>✓ Auto Alerts</strong>
              <div style="color:var(--tz-espresso-600); margin-top:0.15rem;">Vaccine renewals &amp; meds</div>
            </div>
            <div class="tz-pillar-box">
              <strong>✓ Sitter Sheet</strong>
              <div style="color:var(--tz-espresso-600); margin-top:0.15rem;">1-Click printable guide</div>
            </div>
            <div class="tz-pillar-box">
              <strong>✓ Multi-Pet</strong>
              <div style="color:var(--tz-espresso-600); margin-top:0.15rem;">Unlimited pet profiles</div>
            </div>
            <div class="tz-pillar-box">
              <strong>♥ Scrapbook</strong>
              <div style="color:var(--tz-espresso-600); margin-top:0.15rem;">Memories &amp; milestones</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {%- assign pet_col = blank -%}
    {%- if section.settings.collection != blank -%}
      {%- assign pet_col = collections[section.settings.collection] -%}
    {%- endif -%}

    <div class="tz-grid-3">
      {%- if pet_col != blank and pet_col.products.size > 0 -%}
        {%- for product in pet_col.products limit: 3 -%}
          {% render 'product-card', product: product, card_index: forloop.index0 %}
        {%- endfor -%}
      {%- elsif collections['all'] != blank and collections['all'].products.size > 0 -%}
        {%- for product in collections['all'].products limit: 3 -%}
          {% render 'product-card', product: product, card_index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        <div class="tz-card">
          <div class="tz-card-media">
            <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=800&q=80" alt="Pet Parent Notion Sanctuary">
            <div class="tz-card-badges"><span class="tz-badge tz-badge-caramel">♥ Flagship</span></div>
          </div>
          <div class="tz-card-body">
            <div>
              <div class="tz-card-rating"><span>★ 4.98</span><span>Pet Care</span></div>
              <h3 class="tz-card-title">The Modern Pet Parent Notion Sanctuary</h3>
            </div>
            <div class="tz-card-footer">
              <span class="tz-price-now">$22.00</span>
              <span class="tz-badge tz-badge-rose">Add Product in Admin</span>
            </div>
          </div>
        </div>
        <div class="tz-card">
          <div class="tz-card-media">
            <img src="https://images.unsplash.com/photo-1548767797-d8c844163c4c?auto=format&fit=crop&w=800&q=80" alt="Paws & Wellness Journal">
            <div class="tz-card-badges"><span class="tz-badge tz-badge-rose">iPad / GoodNotes</span></div>
          </div>
          <div class="tz-card-body">
            <div>
              <div class="tz-card-rating"><span>★ 4.94</span><span>GoodNotes</span></div>
              <h3 class="tz-card-title">Paws &amp; Wellness iPad Pet Journal</h3>
            </div>
            <div class="tz-card-footer">
              <span class="tz-price-now">$16.00</span>
              <span class="tz-badge tz-badge-rose">Add Product in Admin</span>
            </div>
          </div>
        </div>
        <div class="tz-card">
          <div class="tz-card-media">
            <img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=800&q=80" alt="Puppy First Year Kit">
            <div class="tz-card-badges"><span class="tz-badge tz-badge-caramel">♥ Survival Kit</span></div>
          </div>
          <div class="tz-card-body">
            <div>
              <div class="tz-card-rating"><span>★ 4.99</span><span>Notion</span></div>
              <h3 class="tz-card-title">Puppy &amp; Kitten First Year Survival Kit</h3>
            </div>
            <div class="tz-card-footer">
              <span class="tz-price-now">$15.00</span>
              <span class="tz-badge tz-badge-rose">Add Product in Admin</span>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Pet Collection",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Featured Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Pet-Parent Sanctuary"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "No more lost vaccination cards, forgotten flea treatments, or panic when leaving your fur baby with a sitter."
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Spotlight Image"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Spotlight Title",
      "default": "One Serene Hub for Every Vet Visit, Meal, & Memory"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Pet Collection to Display"
    }
  ],
  "presets": [
    {
      "name": "Featured Pet Collection"
    }
  ]
}
{% endschema %}
