<section class="tz-perks">
  <div class="tz-container">
    <div class="tz-perks-grid">
      {%- for block in section.blocks -%}
        <div class="tz-perk-card" {{ block.shopify_attributes }}>
          <div class="tz-perk-icon" style="background: {{ block.settings.icon_bg }}; border: 1px solid var(--tz-cream-300); color: var(--tz-espresso-900);">
            {%- case block.settings.icon_type -%}
              {%- when 'lightning' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#CE8639" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              {%- when 'mobile' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#BE6E54" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              {%- when 'paw' -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#537158" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg>
              {%- else -%}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6B5B95" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            {%- endcase -%}
          </div>
          <div style="min-width:0;">
            <h4 class="tz-perk-title">{{ block.settings.title }}</h4>
            <p class="tz-perk-desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Perks Strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "perk",
      "name": "Perk Item",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "lightning", "label": "Instant Delivery" },
            { "value": "mobile", "label": "All Devices" },
            { "value": "paw", "label": "Pet Care" },
            { "value": "shield", "label": "Lifetime Updates" }
          ],
          "default": "lightning"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Icon Background",
          "default": "#FAF0E2"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Instant Cloud Delivery"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Receive your 1-click template duplication links immediately upon purchase."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Perks Strip",
      "blocks": [
        {
          "type": "perk",
          "settings": {
            "icon_type": "lightning",
            "icon_bg": "#FAF0E2",
            "title": "Instant Cloud Delivery",
            "description": "Receive your 1-click template duplication links immediately upon purchase."
          }
        },
        {
          "type": "perk",
          "settings": {
            "icon_type": "mobile",
            "icon_bg": "#F9EFEB",
            "title": "100% Free Plan Friendly",
            "description": "Zero premium subscriptions required. Runs on free personal accounts."
          }
        },
        {
          "type": "perk",
          "settings": {
            "icon_type": "paw",
            "icon_bg": "#EBF0EC",
            "title": "Dedicated Pet Care Hubs",
            "description": "Vaccine schedules, vet records, and sitter emergency sheets."
          }
        },
        {
          "type": "perk",
          "settings": {
            "icon_type": "shield",
            "icon_bg": "#F2EFF9",
            "title": "Lifetime Free Updates",
            "description": "Free future improvements & friendly video setup tutorials."
          }
        }
      ]
    }
  ]
}
{% endschema %}
