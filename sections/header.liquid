<header class="tz-header">
  <div class="tz-container tz-header-inner">
    <div class="tz-mobile-menu-trigger">
      <button type="button" data-mobile-open class="tz-icon-btn" aria-label="{{ 'general.accessibility.menu' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>

    <a href="{{ routes.root_url }}" class="tz-logo-link">
      <div class="tz-logo-row">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" style="max-height:36px; width:auto;">
        {%- else -%}
          <span class="tz-logo-title">{{ section.settings.brand_name | default: shop.name }}</span>
          <span class="tz-logo-sparkle">✦</span>
        {%- endif -%}
      </div>
      {%- if section.settings.brand_subtitle != blank -%}
        <span class="tz-logo-sub">{{ section.settings.brand_subtitle }}</span>
      {%- endif -%}
    </a>

    <nav class="tz-nav" aria-label="Main navigation">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}#catalog">All Digital Assets</a>
        <a href="{{ routes.root_url }}#pet-parent-collection" class="tz-nav-pet-pill">
          <span>♥ Pet Parents</span>
          <span class="tz-nav-hot">HOT</span>
        </a>
        <a href="{{ routes.root_url }}#life-planners">Life Planners</a>
        <a href="{{ routes.root_url }}#interactive-mockups">Live Preview</a>
        <a href="{{ routes.root_url }}#faq">FAQ</a>
      {%- endif -%}
    </nav>

    <div class="tz-header-actions">
      <a href="{{ routes.search_url }}" class="tz-icon-btn" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </a>

      <button type="button" data-cart-open class="tz-bag-btn" aria-label="Open Shopping Bag">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span style="display:none;" class="tz-sm-inline">Bag</span>
        <span class="tz-bag-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<div id="tz-mobile-drawer" class="tz-mobile-drawer" aria-hidden="true">
  <div class="tz-backdrop" data-mobile-close></div>
  <div class="tz-mobile-panel">
    <div>
      <div style="display:flex; justify-content:space-between; align-items:center; padding-bottom:1rem; border-bottom:1px solid var(--tz-cream-200);">
        <span class="tz-serif" style="font-size:1.5rem; font-weight:500;">{{ section.settings.brand_name | default: shop.name }} ✦</span>
        <button type="button" data-mobile-close class="tz-icon-btn" aria-label="Close menu">✕</button>
      </div>
      <div class="tz-mobile-links">
        <a href="{{ routes.root_url }}#catalog" data-mobile-close>All Digital Assets</a>
        <a href="{{ routes.root_url }}#pet-parent-collection" data-mobile-close>♥ Pet Parents Collection</a>
        <a href="{{ routes.root_url }}#life-planners" data-mobile-close>Aesthetic Notion Planners</a>
        <a href="{{ routes.root_url }}#interactive-mockups" data-mobile-close>Interactive Device Preview</a>
        <a href="{{ routes.root_url }}#reviews" data-mobile-close>Customer Love &amp; Reviews</a>
        <a href="{{ routes.root_url }}#faq" data-mobile-close>Frequently Asked Questions</a>
      </div>
    </div>

    <div style="font-size:0.75rem; color:var(--tz-espresso-600); padding-top:1rem; border-top:1px solid var(--tz-cream-200);">
      Support: <strong>{{ settings.support_email | default: 'hello@tazvella.com' }}</strong>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name (if no logo image)",
      "default": "Tazvella"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Subheading",
      "default": "Aesthetic Digital Atelier & Pet Care"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu"
    }
  ]
}
{% endschema %}
