<section class="tz-section">
  <div class="tz-container">
    <div class="tz-section-header">
      <h1 class="tz-section-title">All Collections</h1>
    </div>

    <div class="tz-grid-3">
      {%- for col in collections -%}
        <a href="{{ col.url }}" class="tz-card" style="text-decoration:none; color:inherit;">
          <div class="tz-card-media">
            {%- if col.image != blank -%}
              <img src="{{ col.image | image_url: width: 800 }}" alt="{{ col.title | escape }}">
            {%- elsif col.products.first.featured_image != blank -%}
              <img src="{{ col.products.first.featured_image | image_url: width: 800 }}" alt="{{ col.title | escape }}">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=800&q=80" alt="{{ col.title | escape }}">
            {%- endif -%}
          </div>
          <div class="tz-card-body">
            <h2 class="tz-card-title">{{ col.title }}</h2>
            <span style="font-size:0.75rem; color:var(--tz-espresso-600);">{{ col.products_count }} items →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections List",
  "settings": []
}
{% endschema %}
