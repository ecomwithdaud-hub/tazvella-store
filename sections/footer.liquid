<footer class="tz-footer">
  <div class="tz-container">
    <div class="tz-newsletter-box">
      <div style="max-width:34rem;">
        <span style="display:inline-block; padding:0.2rem 0.65rem; border-radius:9999px; background:rgba(134,65,45,0.45); color:#F2D9D0; font-size:0.7rem; font-weight:600; margin-bottom:0.65rem;">
          ✦ Join The Inner Circle
        </span>
        <h3 class="tz-serif" style="font-size:1.65rem; color:#FDFBF9; margin:0; font-weight:500;">
          {{ section.settings.newsletter_heading }}
        </h3>
        <p style="font-size:0.82rem; color:#A7A199; margin:0.5rem 0 0; line-height:1.5;">
          {{ section.settings.newsletter_subtext }}
        </p>
      </div>

      <div style="min-width:280px;">
        {% form 'customer' %}
          {%- if form.posted_successfully? -%}
            <div style="background:rgba(6,78,59,0.5); border:1px solid #047857; color:#A7F3D0; padding:0.85rem 1rem; border-radius:1rem; font-size:0.8rem;">
              ✓ Welcome to {{ shop.name }}! Use code <strong>WELCOME15</strong> at checkout.
            </div>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
              <input
                type="email"
                name="contact[email]"
                required
                placeholder="{{ 'sections.footer.newsletter_placeholder' | t }}"
                style="flex:1; min-width:190px; padding:0.75rem 1rem; border-radius:9999px; background:#13100E; border:1px solid #3A342F; color:#FDFBF9; font-size:0.8rem;"
              >
              <button type="submit" class="tz-btn" style="background:#F2D9D0; color:#13100E; padding:0.75rem 1.35rem; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.06em;">
                {{ 'sections.footer.newsletter_submit' | t }} →
              </button>
            </div>
          {%- endif -%}
        {% endform %}
      </div>
    </div>

    <div class="tz-footer-grid">
      <div>
        <div class="tz-serif" style="font-size:1.85rem; color:#FDFBF9; font-weight:500;">{{ shop.name }} ✦</div>
        <p style="font-size:0.82rem; color:#A7A199; line-height:1.6; max-width:22rem; margin:0.75rem 0;">
          {{ section.settings.about_text }}
        </p>
        <div style="font-size:0.72rem; color:#7E766D;">
          ⚡ Instant Download • 🛡️ Lifetime Access • 🐾 Pet Parent Approved
        </div>
      </div>

      <div>
        <h4 style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.12em; color:#7E766D; margin:0 0 0.85rem;">Collections</h4>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.55rem; font-size:0.82rem;">
          <li><a href="{{ routes.root_url }}#pet-parent-collection" style="color:#CBC7C1; text-decoration:none;">Pet Parent Sanctuaries 🐾</a></li>
          <li><a href="{{ routes.root_url }}#life-planners" style="color:#CBC7C1; text-decoration:none;">Notion Life Planners</a></li>
          <li><a href="{{ routes.root_url }}#catalog" style="color:#CBC7C1; text-decoration:none;">iPad GoodNotes Journals</a></li>
          <li><a href="{{ routes.root_url }}#catalog" style="color:#CBC7C1; text-decoration:none;">Clean Wealth Budget Hubs</a></li>
        </ul>
      </div>

      <div>
        <h4 style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.12em; color:#7E766D; margin:0 0 0.85rem;">Help &amp; Support</h4>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.55rem; font-size:0.82rem;">
          <li><a href="{{ routes.root_url }}#faq" style="color:#CBC7C1; text-decoration:none;">Frequently Asked Questions</a></li>
          <li><a href="{{ routes.root_url }}#reviews" style="color:#CBC7C1; text-decoration:none;">Customer Reviews</a></li>
          <li><a href="mailto:{{ settings.support_email | default: 'hello@tazvella.com' }}" style="color:#CBC7C1; text-decoration:none;">{{ settings.support_email | default: 'hello@tazvella.com' }}</a></li>
        </ul>
      </div>

      <div>
        <h4 style="font-size:0.7rem; text-transform:uppercase; letter-spacing:0.12em; color:#7E766D; margin:0 0 0.85rem;">Compatible With</h4>
        <div style="display:flex; flex-wrap:wrap; gap:0.4rem; font-size:0.72rem; color:#CBC7C1;">
          <span style="padding:0.25rem 0.6rem; background:#1D1917; border:1px solid #2A2522; border-radius:0.45rem;">Notion</span>
          <span style="padding:0.25rem 0.6rem; background:#1D1917; border:1px solid #2A2522; border-radius:0.45rem;">GoodNotes</span>
          <span style="padding:0.25rem 0.6rem; background:#1D1917; border:1px solid #2A2522; border-radius:0.45rem;">iPad &amp; Mac</span>
          <span style="padding:0.25rem 0.6rem; background:#1D1917; border:1px solid #2A2522; border-radius:0.45rem;">Google Sheets</span>
          <span style="padding:0.25rem 0.6rem; background:#1D1917; border:1px solid #2A2522; border-radius:0.45rem;">Canva</span>
        </div>
      </div>
    </div>

    <div style="padding-top:1.5rem; display:flex; flex-wrap:wrap; justify-content:space-between; gap:0.75rem; font-size:0.72rem; color:#7E766D;">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>Instant Cloud Delivery • 256-Bit SSL Encryption</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Headline",
      "default": "Receive 15% off your first aesthetic dashboard."
    },
    {
      "type": "textarea",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext",
      "default": "Plus receive our free Weekly Habit Reset & Dog/Cat Wellness mini-tracker straight to your inbox."
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Brand Description",
      "default": "Thoughtfully curated digital systems, Notion sanctuaries, and pet wellness planners crafted for modern women balancing ambition, peaceful rituals, and deep love for their pets."
    }
  ]
}
{% endschema %}
