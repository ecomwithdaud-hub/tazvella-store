<section class="tz-section">
  <div class="tz-container" style="max-width:54rem;">
    <div class="tz-section-header">
      <h1 class="tz-section-title">{{ 'general.cart.title' | t }}</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div style="display:flex; flex-direction:column; gap:1rem;">
          {%- for item in cart.items -%}
            <div class="tz-cart-item" style="align-items:center;">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">
              {%- endif -%}
              <div style="flex:1;">
                <a href="{{ item.url }}" class="tz-serif" style="font-size:1.1rem; font-weight:600; color:var(--tz-espresso-950); text-decoration:none;">
                  {{ item.product.title }}
                </a>
                {%- unless item.product.has_only_default_variant -%}
                  <div style="font-size:0.75rem; color:var(--tz-espresso-400);">{{ item.variant.title }}</div>
                {%- endunless -%}
                <div style="font-size:0.85rem; margin-top:0.25rem; font-weight:600;">{{ item.final_price | money }}</div>
              </div>
              <div style="display:flex; align-items:center; gap:0.75rem;">
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:60px; text-align:center; padding:0.4rem; border-radius:0.5rem; border:1px solid var(--tz-cream-300);">
                <span class="tz-mono" style="font-weight:700;">{{ item.final_line_price | money }}</span>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="color:var(--tz-espresso-400); text-decoration:none;">✕</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div style="margin-top:1.75rem; padding:1.5rem; border-radius:1.25rem; background:var(--tz-cream-50); border:1px solid var(--tz-cream-200); display:flex; flex-direction:column; gap:1rem;">
          <div style="display:flex; justify-content:space-between; font-size:1.1rem; font-weight:700;">
            <span>{{ 'general.cart.subtotal' | t }}</span>
            <span class="tz-mono">{{ cart.total_price | money }}</span>
          </div>
          <div style="display:flex; gap:0.75rem; justify-content:flex-end;">
            <button type="submit" name="update" class="tz-btn tz-btn-secondary">Update Bag</button>
            <button type="submit" name="checkout" class="tz-btn tz-btn-primary">{{ 'general.cart.checkout' | t }} →</button>
          </div>
        </div>
      </form>
    {%- else -%}
      <div style="text-align:center; padding:3rem 1rem; background:var(--tz-cream-50); border-radius:1.5rem; border:1px solid var(--tz-cream-200);">
        <p class="tz-serif" style="font-size:1.25rem;">{{ 'general.cart.empty' | t }}</p>
        <p style="font-size:0.85rem; color:var(--tz-espresso-600); margin-bottom:1.25rem;">{{ 'general.cart.empty_subtext' | t }}</p>
        <a href="{{ routes.root_url }}" class="tz-btn tz-btn-primary">{{ 'general.cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
