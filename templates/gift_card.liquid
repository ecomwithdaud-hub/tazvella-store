{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} Gift Card</title>
  </head>
  <body style="font-family: Georgia, serif; background:#FAF8F5; color:#1D1917; display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; padding:1rem;">
    <div style="background:#FDFBF9; border:1px solid #ECE3DC; border-radius:1.5rem; padding:2.5rem; text-align:center; max-width:26rem; width:100%;">
      <h1 style="margin-top:0;">{{ shop.name }} Gift Card</h1>
      <p style="font-size:1.75rem; font-weight:bold; color:#BE6E54;">{{ gift_card.initial_value | money }}</p>
      <p style="font-family:monospace; background:#F4EFEB; padding:0.75rem; border-radius:0.5rem; letter-spacing:0.1em;">{{ gift_card.code | format_code }}</p>
      <a href="{{ shop.url }}" style="display:inline-block; margin-top:1rem; padding:0.75rem 1.5rem; background:#1D1917; color:#FDFBF9; border-radius:9999px; text-decoration:none; font-family:sans-serif; font-size:0.85rem;">Shop {{ shop.name }}</a>
    </div>
  </body>
</html>
