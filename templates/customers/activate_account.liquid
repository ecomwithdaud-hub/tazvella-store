<section class="tz-section">
  <div class="tz-container" style="max-width:28rem; background:var(--tz-cream-50); padding:2rem; border-radius:1.5rem; border:1px solid var(--tz-cream-200);">
    <h1 class="tz-serif" style="font-size:1.85rem; margin-top:0;">Activate Account</h1>
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}
      <div style="display:flex; flex-direction:column; gap:0.75rem;">
        <input type="password" name="customer[password]" placeholder="Password" required style="padding:0.75rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300);">
        <input type="password" name="customer[password_confirmation]" placeholder="Confirm Password" required style="padding:0.75rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300);">
        <button type="submit" class="tz-btn tz-btn-primary">Activate</button>
      </div>
    {% endform %}
  </div>
</section>
