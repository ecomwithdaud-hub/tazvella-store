<section class="tz-section">
  <div class="tz-container" style="max-width:28rem; background:var(--tz-cream-50); padding:2rem; border-radius:1.5rem; border:1px solid var(--tz-cream-200);">
    <h1 class="tz-serif" style="font-size:2rem; margin:0 0 1rem; text-align:center;">Create Account</h1>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <div style="display:flex; flex-direction:column; gap:0.75rem;">
        <input type="text" name="customer[first_name]" placeholder="First Name" style="padding:0.75rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300); background:var(--tz-cream-100);">
        <input type="text" name="customer[last_name]" placeholder="Last Name" style="padding:0.75rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300); background:var(--tz-cream-100);">
        <input type="email" name="customer[email]" placeholder="Email" required style="padding:0.75rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300); background:var(--tz-cream-100);">
        <input type="password" name="customer[password]" placeholder="Password" required style="padding:0.75rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300); background:var(--tz-cream-100);">
        <button type="submit" class="tz-btn tz-btn-primary">Register</button>
      </div>
    {% endform %}
  </div>
</section>
