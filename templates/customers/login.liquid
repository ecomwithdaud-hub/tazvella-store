<section class="tz-section">
  <div class="tz-container" style="max-width:28rem; background:var(--tz-cream-50); padding:2rem; border-radius:1.5rem; border:1px solid var(--tz-cream-200);">
    <h1 class="tz-serif" style="font-size:2rem; margin:0 0 1rem; text-align:center;">Sign In</h1>
    {% form 'customer_login' %}
      {{ form.errors | default_errors }}
      <div style="display:flex; flex-direction:column; gap:0.75rem;">
        <input type="email" name="customer[email]" placeholder="Email" required style="padding:0.75rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300); background:var(--tz-cream-100);">
        <input type="password" name="customer[password]" placeholder="Password" required style="padding:0.75rem 1rem; border-radius:0.75rem; border:1px solid var(--tz-cream-300); background:var(--tz-cream-100);">
        <button type="submit" class="tz-btn tz-btn-primary">Sign In</button>
      </div>
    {% endform %}
    <div style="text-align:center; margin-top:1rem; font-size:0.8rem;">
      <a href="{{ routes.account_register_url }}" style="color:var(--tz-rose-700);">Create an account</a>
    </div>
  </div>
</section>
